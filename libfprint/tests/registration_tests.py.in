    # timeclock-system: registration scores single presses and builds a print from the ones it keeps.
    def capture_press(self, image, **transform):
        self._press_fp = None

        def identify_cb(dev, res):
            self._press_fp = dev.identify_finish(res)[1]

        self.dev.identify([], callback=identify_cb)
        self.wait_for_finger_status(FPrint.FingerStatusFlags.NEEDED)
        self.send_image(image, **transform)
        while self._press_fp is None:
            ctx.iteration(True)
        return self._press_fp

    def test_score_press_same_finger(self):
        enrolled = self.enroll_print('whorl')
        press = self.capture_press('whorl', dx=2, dy=-1, angle=0.03)
        other = self.capture_press('arch')
        scores = press.score_press(0, enrolled)
        self.assertEqual(len(scores), self.dev.get_nr_enroll_stages())
        self.assertGreaterEqual(min(scores), 40)
        self.assertLess(max(other.score_press(0, enrolled)), min(scores))

    def test_score_press_within_one_print(self):
        enrolled = self.enroll_print('whorl')
        scores = enrolled.score_press(0, enrolled)
        self.assertEqual(len(scores), self.dev.get_nr_enroll_stages())
        self.assertGreaterEqual(min(scores), 40)

    def test_score_press_bad_index(self):
        enrolled = self.enroll_print('whorl')
        press = self.capture_press('whorl')
        with self.assertRaises(GLib.Error):
            press.score_press(1, enrolled)

    def test_new_from_presses_round_trip(self):
        presses = [self.capture_press('whorl', dx=d, dy=-d, angle=0.01 * d) for d in range(5)]
        made = FPrint.Print.new_from_presses(presses)
        restored = FPrint.Print.deserialize(made.serialize())
        self.assertEqual(restored.get_driver(), presses[0].get_driver())
        self.assertEqual(restored.get_device_id(), presses[0].get_device_id())
        # Each press is kept, in order: press i scores against restored press i as it does against itself.
        for i, press in enumerate(presses):
            self.assertEqual(press.score_press(0, restored)[i], press.score_press(0, press)[0])
        self.assertIs(self.identify_image([restored], 'whorl', dx=1), restored)

    def test_new_from_presses_refuses_a_template(self):
        enrolled = self.enroll_print('whorl')
        with self.assertRaises(GLib.Error):
            FPrint.Print.new_from_presses([enrolled])
