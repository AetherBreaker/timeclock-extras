-fp_print_score_press (FpPrint *print,
-                      guint    index,
-                      FpPrint *other,
-                      gsize   *n_scores,
-                      GError **error)
+fp_print_score_press (FpPrint      *print,
+                      guint         index,
+                      FpPrint      *other,
+                      GCancellable *cancellable,
+                      gsize        *n_scores,
+                      GError      **error)
 {
   struct xyt_struct *pstruct;
   gint *scores;
@@ -478,11 +488,26 @@ fp_print_score_press (FpPrint *print,
       return NULL;
     }
 
+  if (g_cancellable_set_error_if_cancelled (cancellable, error))
+    return NULL;
+
   pstruct = g_ptr_array_index (print->prints, index);
+  /* This thread's check, for this call only: the identify path, on its own thread, never sets one. */
+  bz_cancel_check = cancellable ? score_cancelled : NULL;
+  bz_cancel_data = cancellable;
   probe_len = bozorth_probe_init (pstruct);
   scores = g_new (gint, MAX (other->prints->len, 1));
-  for (i = 0; i < other->prints->len; i++)
+  for (i = 0; i < other->prints->len && !g_cancellable_is_cancelled (cancellable); i++)
     scores[i] = bozorth_to_gallery (probe_len, pstruct, g_ptr_array_index (other->prints, i));
+  bz_cancel_check = NULL;
+  bz_cancel_data = NULL;
+
+  /* A cancelled bozorth3 call returns early with a meaningless score: the whole call reports the cancel instead. */
+  if (g_cancellable_set_error_if_cancelled (cancellable, error))
+    {
+      g_free (scores);
+      return NULL;
+    }
 
   *n_scores = other->prints->len;
   return scores;
