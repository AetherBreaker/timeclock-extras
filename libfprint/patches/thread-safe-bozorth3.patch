+/* timeclock-system: every mutable table above is thread-local, so threads can match at once. A caller that wants its
+   match stoppable sets this thread's check for the duration of the call; bozorth3's long loops ask bz_cancelled(). */
+_Thread_local int (*bz_cancel_check)( void * ) = 0;
+_Thread_local void * bz_cancel_data = 0;
+
+int bz_cancelled( void )
+{
+return bz_cancel_check != 0 && bz_cancel_check( bz_cancel_data );
+}
